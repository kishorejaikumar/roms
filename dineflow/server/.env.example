# Copy to .env and fill in. NEVER commit .env.
# Supabase: Project Settings -> Database -> Connection string (use the "Session pooler" or "Direct" string)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/dineflow
# Set to "off" for a local PostgreSQL without SSL; leave unset for Supabase
PGSSL=off
# Long random string (run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
TOKEN_SECRET=change-me-to-a-long-random-string
PORT=3000
# Comma separated list of allowed browser origins if the front end is hosted elsewhere (leave empty when served by this app)
CORS_ORIGINS=
